// --- Fetch all four sources fresh (no cache) ---
async function fetchText(url) {
  const res = await fetch(url, { cache: "no-store" });
  if (!res.ok) throw new Error("Could not load " + url + " (HTTP " + res.status + ")");
  return res.text();
}
async function loadTonight() {
  const [tonightTxt, routesTxt, planTxt, forecastTxt] = await Promise.all([
    fetchText(SOURCES.tonight), fetchText(SOURCES.routes), fetchText(SOURCES.plan), fetchText(SOURCES.forecast)
  ]);
  let forecast = JSON.parse(forecastTxt);
  if (!Array.isArray(forecast)) forecast = [forecast];
  const routes = parseCSV(routesTxt);
  const depots = parseCSV(tonightTxt);
  if (forecast.length !== routes.length) throw new Error(`Forecast has ${forecast.length} points but there are ${routes.length} routes.`);
  const generatedAt = new Date().toLocaleString("en-IE", { timeZone: "Europe/Dublin", dateStyle: "medium", timeStyle: "short" });
  return { routes, depots, plan: planTxt, forecast, generatedAt, result: analyse(routes, depots, forecast) };
}

// --- Call Anthropic directly from the browser ---
async function askClaude(system, userContent) {
  const key = load(STORE_KEY);
  if (!key) throw new Error("No API key saved. Add it in Settings first.");
  const model = load(STORE_MODEL) || DEFAULT_MODEL;
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "content-type": "application/json",
      "x-api-key": key,
      "anthropic-version": "2023-06-01",
      "anthropic-dangerous-direct-browser-access": "true"
    },
    body: JSON.stringify({
      model,
      // Haiku 5.5 thinks before answering by default, and thinking counts toward max_tokens.
      // 1024 was too small: hard questions used it all on thinking and returned no text.
      max_tokens: 16000,
      output_config: {
        effort: "low",                                        // explaining a computed table needs little thinking
        format: { type: "json_schema", schema: ANSWER_SCHEMA } // structured answer the page can draw as a card
      },
      system,
      messages: [{ role: "user", content: userContent }]
    })
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error((data.error && data.error.message) || ("HTTP " + res.status));
  const text = (data.content || []).filter(b => b.type === "text").map(b => b.text).join("\n").trim();
  if (data.stop_reason === "refusal") {
    throw new Error("The model declined to answer this question (stop reason: refusal).");
  }
  if (!text) {
    throw new Error(data.stop_reason === "max_tokens"
      ? "The model ran out of tokens before writing an answer (stop reason: max_tokens). Try again or ask a shorter question."
      : "The model returned no text (stop reason: " + (data.stop_reason || "unknown") + ").");
  }
  let parsed = null;
  try { parsed = JSON.parse(text); } catch (e) { /* fall back to showing plain text */ }
  return { text, parsed, model: data.model || model, usage: data.usage || {}, stopReason: data.stop_reason };
}

// --- Render helpers ---
function badge(status) {
  const cls = { "TREAT": "b-treat", "NEEDS COVER": "b-cover", "HELD BACK": "b-held", "NO TREAT": "b-none" }[status] || "b-none";
  return `<span class="badge ${cls}">${esc(status)}</span>`;
}
const STATUS_ORDER = { "NEEDS COVER": 0, "TREAT": 1, "HELD BACK": 2, "NO TREAT": 3 };
function sortLines(lines) {
  return [...lines].sort((a, b) => STATUS_ORDER[a.status] - STATUS_ORDER[b.status] || a.priority - b.priority || a.id.localeCompare(b.id));
}

