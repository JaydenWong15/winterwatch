// The AI's structured answer, drawn as a coloured card
const VERDICT_STYLE = {
  YES: ["v-yes", "YES"], NO: ["v-no", "NO"], DEPENDS: ["v-depends", "DEPENDS"],
  CANT_DO: ["v-cant", "CAN'T DO"], INFO: ["v-info", "INFO"]
};
function answerCard(a, question, hideWarnings) {
  const [cls, label] = VERDICT_STYLE[a.verdict] || VERDICT_STYLE.INFO;
