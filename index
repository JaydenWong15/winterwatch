  } catch (e) {
    out.innerHTML = `<div class="answer err">Data error: ${esc(e.message)}</div>`;
    buttons.forEach(b => b.disabled = false);
    return;
  }

  out.innerHTML = `<div class="question-echo">Q: ${esc(question)}</div><div class="answer">Thinking…</div>`;

  const userContent =
    `<plan>\n${data.plan}\n</plan>\n\n<data>\n${briefForAI(data.result, data.generatedAt)}\n</data>\n\nMODE: ${mode}\nQUESTION FROM THE DUTY ENGINEER:\n${question}`;

  let html = "";
  let parsed = null;
  try {
    const r = await askClaude(SYSTEM_PROMPT, userContent);
    parsed = r.parsed;
    html = parsed ? answerCard(parsed, question, mode === "overview")
                  : `<div class="question-echo">Q: ${esc(question)}</div><div class="answer">${esc(r.text)}</div>`;
    const u = r.usage || {};
    html += `<div class="meta">Model: ${esc(r.model)} · tokens in ${u.input_tokens ?? "?"} / out ${u.output_tokens ?? "?"}` +
      (r.stopReason && r.stopReason !== "end_turn" ? ` · stop reason: ${esc(r.stopReason)}` : "") + `</div>`;
  } catch (e) {
    html = `<div class="question-echo">Q: ${esc(question)}</div><div class="answer err">AI error: ${esc(e.message)} — the computed data below is still valid.</div>`;
  }

  if (mode === "overview") {
    html += overview(data) + moreSection(data, false);
  } else {
    const focus = routesInFocus(parsed, question, data.result.lines);
    if (focus.size) {
      html += `<h3>Routes in this answer</h3>` + routeTable(data.result.lines.filter(l => focus.has(l.id)), focus);
    }
    html += moreSection(data, false);
  }
  out.innerHTML = html;
  buttons.forEach(b => b.disabled = false);
}


$("callBtn").addEventListener("click", () => run(STANDARD_QUESTION, "overview"));
$("askBtn").addEventListener("click", () => {
  const q = $("question").value.trim();
  if (!q) { $("question").focus(); return; }
  run(q, "question");
});
$("question").addEventListener("keydown", e => {
  if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) $("askBtn").click();
});
</script>
</body>
</html>
