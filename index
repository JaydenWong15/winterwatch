    </div>`;
}

// Night timeline for one route: run bar (leave -> finish) and the 0 C / coldest-hour marker
function timeline(l, start, end) {
  const span = end - start;
  const pct = t => Math.max(0, Math.min(100, (t - start) / span * 100));
  const ticks = [];
  for (let t = new Date(start); t <= end; t = new Date(t.getTime() + 4 * 3600e3)) {
    const p = pct(t);
    const shift = p <= 0 ? "translateX(0)" : p >= 100 ? "translateX(-100%)" : "translateX(-50%)";   // keep end labels inside the bar
    ticks.push(`<span class="tl-tick" style="left:${p}%;transform:${shift}">${String(t.getUTCHours()).padStart(2, "0")}:00</span>`);
  }
  const runL = pct(l.leave), runR = pct(l.finish);
  return `
    <div class="timeline" role="img" aria-label="Leave ${fmtClock(l.leave)}, finish ${fmtClock(l.finish)}, ${l.targetIsZero ? "ground 0 °C" : "coldest"} at ${fmtClock(l.target)}">
      <div class="tl-run" style="left:${runL}%;width:${Math.max(1, runR - runL)}%"></div>
      <div class="tl-mark ${l.targetIsZero ? "" : "cold"}" style="left:${pct(l.target)}%"></div>
      ${ticks.join("")}
    </div>`;
}

// Visual overview for "Get tonight's call" (drawn from the computed data, not the AI)
function overview(data) {
  const lines = data.result.lines;
  const act = sortLines(lines.filter(l => l.status === "TREAT" || l.status === "NEEDS COVER"));
  let cards = "";
  if (act.length) {
    const ev = act.find(l => l.evening) ? act.find(l => l.evening).evening : null;
    const start = new Date(ev); start.setUTCHours(16, 0, 0, 0);
    const end = new Date(start.getTime() + 18 * 3600e3);
    cards = `<div class="rcards">${act.map(l => `
      <div class="rcard ${l.status === "NEEDS COVER" ? "cover" : ""}">
        <div class="rcard-top"><span><b>${esc(l.id)}</b> ${esc(l.name)} · P${l.priority}</span>${badge(l.status)}</div>
        <div class="rcard-sub">Leave <b>${fmtClock(l.leave)}</b> → finish <b>${fmtClock(l.finish)}</b> · ${l.saltNeed} t salt · ${esc(l.depot)} depot · ground ${l.minGround.toFixed(1)} °C</div>
        ${timeline(l, start, end)}
        ${l.flags.length ? `<div class="rcard-sub" style="color:var(--err)">⚠ ${esc(l.flags.join("; "))}</div>` : ""}
        ${l.cover ? `<div class="rcard-sub">Possible cover: <b>${esc(l.cover.depot)}</b> (~${l.cover.km} km), engineer to approve</div>` : ""}
      </div>`).join("")}
      <div class="legend"><span><i style="background:var(--accent)"></i>Truck run</span><span><i style="background:var(--err)"></i>Ground hits 0 °C</span><span><i style="background:var(--warn)"></i>Coldest hour (no 0 °C)</span></div>
    </div>`;
  }
  const held = lines.filter(l => l.status === "HELD BACK");
  const above = lines.filter(l => l.status === "NO TREAT" && l.minGround > l.limit);
  const dry = lines.filter(l => l.status === "NO TREAT" && l.minGround <= l.limit);
  const chipList = (arr, cls, fn) => arr.length ? `<div class="chips">${sortLines(arr).map(l => `<span class="chip ${cls}" title="${esc(l.reason)}">${esc(l.id)} · ${fn(l)}</span>`).join("")}</div>` : "";
  const groups =
    (held.length ? `<div class="group-label">Held back</div>${chipList(held, "held", l => "depot " + esc(l.depot))}` : "") +
    (above.length ? `<div class="group-label">Not treated: ground stays above limit</div>${chipList(above, "", l => l.minGround.toFixed(1) + " °C > " + l.limit.toFixed(1))}` : "") +
    (dry.length ? `<div class="group-label">Not treated: road stays dry</div>${chipList(dry, "", l => l.minGround.toFixed(1) + " °C, dry")}` : "");
  const alerts = data.result.alerts.length
    ? `<div class="group-label">Depot alerts</div><div class="alerts">${data.result.alerts.map(a => `<div class="alert ${a.kind}">⚠ ${esc(a.text)}</div>`).join("")}</div>` : "";
  return cards + groups + alerts;
}

// Routes the answer is about: from the AI, plus any route ids typed in the question
function routesInFocus(a, question, lines) {
  const ids = new Set(lines.map(l => l.id));
  const found = new Set();
  (a && a.routes || []).forEach(r => { const id = String(r).toUpperCase().trim(); if (ids.has(id)) found.add(id); });
  (question.toUpperCase().match(/\bR\d{2}\b/g) || []).forEach(id => { if (ids.has(id)) found.add(id); });
  return found;
}

